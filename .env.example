# Copy this file to .env.local and fill in real values.
# See 04_BUILD_GUIDE.md ("API Integration, External Services & Security") for details.
#
# Nothing here is required for Manual Mode (Version 0.1) — every field has a safe
# default or is optional. Missing/invalid values are reported clearly at startup
# by utils/env.ts.

# --- Public app metadata -----------------------------------------------------
NEXT_PUBLIC_APP_NAME=ProfitPilot
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# --- Price provider (optional — Manual Mode works without it) ---------------
NEXT_PUBLIC_PRICE_API_URL=
COINGECKO_API_KEY=

# --- Supabase (optional — cloud sync/auth are a later milestone) ------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Sentry (optional — error monitoring) ------------------------------------
SENTRY_DSN=
