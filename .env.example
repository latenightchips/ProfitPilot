# Copy this file to .env.local and fill in real values.
# See 04_BUILD_GUIDE.md ("API Integration, External Services & Security") for details.
#
# Nothing here is required for Manual Mode (Version 0.1) — every field has a safe
# default or is optional. Missing/invalid values are reported clearly at startup
# by utils/env.ts.

# --- Public app metadata -----------------------------------------------------
NEXT_PUBLIC_APP_NAME=ProfitPilot
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# --- Price provider (optional — Manual Mode works without it) ---------------
NEXT_PUBLIC_PRICE_API_URL=
COINGECKO_API_KEY=

# --- Supabase (optional — dormant Auth capability; Cloud Sync is cancelled) -
# Must be NEXT_PUBLIC_-prefixed: services/auth/supabaseClient.ts constructs
# the client in the browser, and Next.js only inlines NEXT_PUBLIC_* values
# into the client bundle (see utils/env.ts's own header comment, M9-030).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sentry (optional — error monitoring, M9-049) ----------------------------
# Must be NEXT_PUBLIC_-prefixed: instrumentation-client.ts initializes Sentry
# in the browser, and Next.js only inlines NEXT_PUBLIC_* values into the
# client bundle (same reasoning as Supabase above). A DSN is a write-only
# ingestion identifier, not a secret, so this is safe to expose.
NEXT_PUBLIC_SENTRY_DSN=
